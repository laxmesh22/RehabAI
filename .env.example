# Copy to .env and replace placeholders. Never commit .env.
SARVAM_API_KEY=replace_with_rotated_sarvam_key
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

ANTHROPIC_API_KEY=replace_with_rotated_anthropic_key
ANTHROPIC_MODEL=claude-sonnet-5

ELEVENLABS_API_KEY=replace_with_rotated_elevenlabs_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# auto STT: Sarvam first for intake. Talk uses ElevenLabs Scribe first, then Sarvam.
# TTS prefers Sarvam Bulbul speaker shubh (Subh). ElevenLabs is fallback only.
REHABAI_STT=auto
REHABAI_TTS=sarvam

# Keep simulation explicit until the Jetson + D455i path is verified on hardware.
REHABAI_SOURCE=simulation
REHABAI_VOICE_TIMEOUT_S=20

# Phone RGB may use a local pose model OR a separately hosted inference service.
# Phone results are labelled 2D-derived and never claim RealSense depth.
REHABAI_POSE_KIND=yolo
REHABAI_POSE_DEVICE=cpu
REHABAI_POSE_MODEL=C:/absolute/path/to/approved-pose-model.pt
# REHABAI_PHONE_INFERENCE_URL=http://gpu-server:8010
# REHABAI_PHONE_INFERENCE_API_KEY=replace_with_a_random_internal_service_key
# REHABAI_PHONE_INFERENCE_TIMEOUT_S=8
# REHABAI_PHONE_FRAME_MAX_BYTES=1500000
# REHABAI_PHONE_FRAME_MAX_PIXELS=2073600
# REHABAI_PHONE_FRAME_MIN_INTERVAL_S=0.18
