# Copy to .env and replace placeholders. Never commit .env.
SARVAM_API_KEY=replace_with_rotated_sarvam_key
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# Claude (optional) rephrases Talk and the clinician assistant from retrieved protocol chunks + measured numbers.
# Local protocol RAG always runs even if this key is empty. ROM / BLOCK never depend on Claude.
ANTHROPIC_API_KEY=replace_with_rotated_anthropic_key
ANTHROPIC_MODEL=claude-sonnet-5

ELEVENLABS_API_KEY=replace_with_rotated_elevenlabs_key
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# Talk TTS uses ElevenLabs George. STT: ElevenLabs Scribe first when auto (Sarvam out of credits).
# Optional: REHABAI_TTS=sarvam for Bulbul Subh (shubh) when Sarvam credits exist.
REHABAI_STT=elevenlabs
REHABAI_TTS=elevenlabs

# Keep simulation explicit until the Jetson + D455i path is verified on hardware.
REHABAI_SOURCE=simulation
REHABAI_VOICE_TIMEOUT_S=20

# Phone RGB: opencv = Shoulder Tracker MediaPipe Solutions (no .task/.pt file; Python 3.12).
# Start-RehabAI.ps1 bootstraps .venv + a local pose sidecar on :8091 when the API
# interpreter cannot import mediapipe (e.g. host Python 3.13). Results stay labelled
# phone_rgb_2d / 2D-derived and never claim RealSense depth.
REHABAI_POSE_KIND=opencv
REHABAI_POSE_DEVICE=cpu
# REHABAI_POSE_MODEL=C:/absolute/path/to/approved-pose-model.pt
# REHABAI_PHONE_INFERENCE_URL=http://127.0.0.1:8091
# REHABAI_POSE_SIDECAR_PORT=8091
# REHABAI_PHONE_INFERENCE_API_KEY=replace_with_a_random_internal_service_key
# REHABAI_PHONE_INFERENCE_TIMEOUT_S=8
# REHABAI_PHONE_FRAME_MAX_BYTES=1500000
# REHABAI_PHONE_FRAME_MAX_PIXELS=2073600
# REHABAI_PHONE_FRAME_MIN_INTERVAL_S=0.12
# REHABAI_OPENCV_POSE_COMPLEXITY=1
# REHABAI_OPENCV_POSE_MIN_VIS=0.4
# REHABAI_OPENCV_POSE_MAX_SIDE=960
