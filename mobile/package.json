{
  "name": "rehabai-consumer",
  "version": "0.1.0",
  "private": true,
  "description": "RehabAI consumer APK shell (Capacitor). Talk-first patient app.",
  "scripts": {
    "sync-web": "node scripts/sync-web.js",
    "cap:sync": "npm run sync-web && npx cap sync android",
    "cap:open": "npx cap open android",
    "build:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
